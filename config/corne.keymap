#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define DEFAULT 0
#define LOWER   1
#define RAISE   2
#define BT      3

&mt {
    tapping-term-ms = <200>;
};

/ {
    combos {
        combo_bt {
            timeout-ms = <100>;
            key-positions = <37 40>; // LOWER + RAISE correctos
            bindings = <&mo BT>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
// -----------------------------------------------------------------------------------------
            bindings = <
   &kp ESC   &kp Q &kp W &kp E &kp R &kp T          &kp Y &kp U  &kp I  &kp O   &kp P    &kp BSPC
   &kp TAB &kp A &kp S &kp D &kp F &kp G            &kp H &kp J  &kp K  &kp L   &kp SEMI &kp SQT
   &mt LSHIFT CAPSLOCK  &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &kp RET
                  &kp LCMD &mo LOWER &kp SPACE   &mt RCTRL SPACE &mo RAISE &kp RALT
            >;
        };

        lower_layer {
// -----------------------------------------------------------------------------------------
            bindings = <
   &kp ESC    &kp N1 &kp N2 &kp N3 &kp N4 &kp N5     &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp BSPC
   &kp TAB    &trans &trans &trans &trans &trans     &trans &trans &kp UP &trans &trans &kp LG(LS(N4))
   &kp LSHFT  &trans &trans &trans &trans &trans     &trans &kp LEFT &kp DOWN &kp RIGHT &trans &kp RET
                        &kp LCMD &trans &kp SPACE   &mt RCTRL SPACE &trans &kp RALT
            >;
        };

        raise_layer {
// -----------------------------------------------------------------------------------------
            bindings = <
   &kp ESC  &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT   &kp CARET &kp AMPS  &kp ASTRK &kp LPAR &kp RPAR &kp BSPC
   &kp TAB  &kp K_VOLUME_UP &kp K_VOLUME_DOWN &kp K_MUTE &trans &trans  &kp EQUAL &kp MINUS &kp LBKT &kp RBKT &kp BSLH &kp GRAVE
   &kp LSHFT &kp PSCRN &trans &trans &trans &trans       &kp UNDER &kp PLUS &kp LBRC &kp RBRC &kp PIPE &kp TILDE
                        &kp LCMD &trans &kp SPACE   &mt RCTRL SPACE &trans &kp RALT
            >;
        };

        bt_layer {
// -----------------------------------------------------------------------------------------
            bindings = <
   &trans &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &trans &trans &trans &trans &trans &trans
   &trans &trans       &trans       &trans       &trans       &trans         &trans &trans &trans &trans &trans &trans
   &trans &bt BT_CLR   &bt BT_CLR_ALL &trans     &trans       &trans         &trans &trans &trans &trans &trans &trans
                        &trans &trans &trans     &trans       &trans &trans
            >;
        };
    };
};